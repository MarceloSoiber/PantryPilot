# Configuração apenas para o PostgreSQL local do Docker Compose.
POSTGRES_DB=pantry_pilot
POSTGRES_USER=pantry_pilot
POSTGRES_PASSWORD=troque-esta-senha-local

# Configuração da API executada no host. O hostname é localhost porque esta URL
# é usada fora da rede interna do Docker Compose.
DATABASE_URL=postgresql://pantry_pilot:troque-esta-senha-local@localhost:5432/pantry_pilot
HEALTHCHECK_TIMEOUT_MS=1000
PORT=3000
