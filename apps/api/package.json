{
  "name": "@pantry-pilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "NODE_OPTIONS=--conditions=development tsx src/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=development tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@pantry-pilot/contracts": "file:../../packages/contracts",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pg": "^8.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
